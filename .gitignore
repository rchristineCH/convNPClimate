# Input data stays out of git — fetch it via datasets/README.md
datasets/**
!datasets/**/*.py
!datasets/README.md
# Hourly ERA5-Land tp downloads; rebuild with scripts/build_tp_from_hourly.py
tp_hourly/raw/

# Python
__pycache__/
*.pyc
*.egg-info/

# Editors / OS
.vscode/
.DS_Store

# Prediction-bundle caches (GBs; regenerated by evaluate.load_or_predict /
# eval_precip.load_or_predict)
pred_cache/

# Verbose run/driver stdout
*.log

# Feature-importance resume artifacts (pfi.csv/lime.csv are the outputs)
**/feature_importance/_raw_*
**/feature_importance_[0-9][0-9][0-9][0-9]/_raw_*

# Pickled figure objects saved next to PNGs for later re-styling (regenerable)
*.fig.pkl

# Staging dir of scripts/collect_result_figures.py; the kept copies live under
# LATEX_REPORT/images and RESULT_FIGURES_INDEX.md maps names to sources
RESULT_FIGURES/
CLEAN_eval_shared/
reeval_logs/
